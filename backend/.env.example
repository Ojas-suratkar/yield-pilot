# On a laptop, scripts/use_cloud.sh writes this file with the production values and keys from Secret Manager.
ENV=local                                  # local | staging | prod (local only enables the API docs and dev sign-in)
# Always Cloud SQL: through the proxy on a laptop (scripts/dev.sh starts it), a /cloudsql socket on Cloud Run
DATABASE_URL=postgresql+asyncpg://app:<password>@127.0.0.1:5433/yieldpilot
GCS_BUCKET=yieldpilot-csulb-data
GCP_PROJECT=yieldpilot-csulb
ALLOWED_DOMAINS=csulb.edu
PSEUDONYM_KEY=local-dev-only               # 32+ random chars outside local
MAX_UPLOAD_MB=500

# Auth: dev (X-Dev-User header, local only) | microsoft
AUTH_MODE=dev
FRONTEND_ORIGIN=http://localhost:5174
JWT_SECRET=local-dev-only                  # 32+ random chars outside local
SESSION_HOURS=8
# Entra ID app registration (redirect URI: <FRONTEND_ORIGIN>/api/auth/microsoft/callback)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
CONNECTION_KEY=   # Fernet key: python -c 'from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())'
